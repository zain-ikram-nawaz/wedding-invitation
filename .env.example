# Optional absolute path to a persistent writable directory (default: ./data).
# RSVP_DATA_DIR=/var/lib/wedding-invitation
# Exact public origin when deployed behind a reverse proxy (no trailing slash).
# APP_ORIGIN=https://wedding.example.com
# Password for the hosts' guest list at /guests (required to enable that page).
# ADMIN_PASSWORD=choose-a-long-password
